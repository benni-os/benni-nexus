{
  "name": "benni-nexus",
  "version": "0.1.0",
  "description": "LLM gateway for the Benni OS ecosystem",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nexus": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "keywords": ["llm", "gateway", "router", "ollama", "openai", "mcp", "ai", "benni-os"],
  "author": "Benni Alencar",
  "license": "MIT",
  "engines": { "node": ">=20.0.0" },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "zod": "^3.23.0",
    "undici": "^8.9.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "ts-node": "^10.9.0",
    "@types/node": "^22.0.0",
    "vitest": "^4.1.10",
    "eslint": "^10.8.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "prettier": "^3.3.0"
  }
}
